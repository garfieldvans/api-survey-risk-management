# PostgreSQL (Neon / lokal)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Secret untuk JWT (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="ganti-dengan-secret-panjang"

PORT=4000

# Origin web yang diizinkan CORS (pisahkan dengan koma kalau lebih dari satu)
WEB_ORIGIN="http://localhost:5173"

# Cloudflare R2 untuk upload attachment (kosongkan jika belum dipakai — upload dinonaktifkan)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="survey-reports"
R2_PUBLIC_URL=""
