# PostgreSQL (Neon / lokal)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Secret untuk JWT (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="ganti-dengan-secret-panjang"

PORT=4000

# Origin web yang diizinkan CORS (pisahkan dengan koma kalau lebih dari satu)
WEB_ORIGIN="http://localhost:5173"

# Object storage S3-compatible (bawaan: Backblaze B2 — tanpa kartu kredit).
# Langkah:
#  1) B2 Cloud Storage → Create a new bucket (contoh: survey-photos), set Private.
#  2) B2 Cloud Storage → Application Keys → Create a new key, pilih bucket target,
#     access: read & write.
#  3) Isi variabel di bawah (endpoint & region sesuai region bucket kamu.
#    Contoh: region us-west-002 → endpoint https://s3.us-west-002.backblazeb2.com
STORAGE_ENDPOINT="https://s3.us-east.backblazeb2.com"
STORAGE_REGION="us-east"
STORAGE_FORCE_PATH_STYLE=true
B2_KEY_ID="005f6d3014ab9f70000000003"
B2_APPLICATION_KEY="K005E5aAIV3ta8Tdc7zIw0qOEtOFRKQ"
STORAGE_BUCKET="survey-docs-key"

# Cloudflare R2 — alternatif; untuk pakai R2 ganti endpoint jadi
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com dan kosongkan STORAGE_FORCE_PATH_STYLE.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="survey-reports"
R2_PUBLIC_URL=""
